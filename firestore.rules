/**
 * Firestore Security Rules - Calm Points Economy
 *
 * Core Principles:
 * 1. Users CANNOT directly write transactions (Cloud Functions only)
 * 2. Timestamps MUST be server-generated (prevent time-cheating)
 * 3. Balance is DERIVED from ledger (never stored directly)
 * 4. Admins can adjust points (with 2FA audit trail)
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    /**
     * Check if user is authenticated
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Check if user owns this document
     */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * Check if user has admin role
     */
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    /**
     * Validate transaction type is in allowed enum
     */
    function isValidTransactionType(type) {
      return type in [
        'task_complete',
        'gate_survived',
        'gate_bypassed',
        'store_purchase',
        'streak_reset',
        'admin_adjustment'
      ];
    }

    // ========== USERS COLLECTION ==========

    match /users/{userId} {
      /**
       * Users can READ their own profile
       */
      allow read: if isOwner(userId);

      /**
       * Users can UPDATE ONLY specific fields
       * FORBIDDEN: currentStreak, totalPointsLifetime, lastActivityDate
       */
      allow write: if isOwner(userId) &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['onboardingCompleted', 'metadata']);

      /**
       * Admin override
       */
      allow write: if isAdmin();

      // ========== TRANSACTIONS SUB-COLLECTION ==========

      match /transactions/{transactionId} {
        /**
         * Users can READ their own transactions
         */
        allow read: if isOwner(userId);

        /**
         * ENFORCED: Direct writes FORBIDDEN
         * Only Cloud Functions can create transactions
         */
        allow create, update, delete: if false;
      }

      // ========== PURCHASES SUB-COLLECTION ==========

      match /purchases/{itemId} {
        /**
         * Users can READ their own purchases
         */
        allow read: if isOwner(userId);

        /**
         * ENFORCED: Direct writes FORBIDDEN
         * Only Cloud Functions (after balance check) can create
         */
        allow create, update, delete: if false;
      }
    }

    // ========== PREMIUM STORE COLLECTION ==========

    match /premium_store/{itemId} {
      /**
       * Everyone can READ store items
       */
      allow read: if isAuthenticated();

      /**
       * Only admins can write
       */
      allow write: if isAdmin();
    }

    // ========== AUDIT LOGS (Optional) ==========

    match /audit_logs/{logId} {
      /**
       * Admins can READ audit logs
       */
      allow read: if isAdmin();

      /**
       * Cloud Function writes audit trail
       */
      allow create: if request.auth.uid == 'cloud-function';
    }
  }
}
